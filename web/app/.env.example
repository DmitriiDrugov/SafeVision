# SafeVision Web — example environment.
#
# Two modes:
#  1) Demo (Vercel / static deploy)  — NEXT_PUBLIC_DEMO_MODE=true and *_URL left empty
#  2) Connected (docker compose)     — DEMO_MODE=false, URLs point at backend services

# ── Mode ──────────────────────────────────────────────────────────────────
# Force demo mode regardless of API health (recommended for Vercel).
# When unset, the UI auto-detects: empty NEXT_PUBLIC_API_URL → demo mode.
NEXT_PUBLIC_DEMO_MODE=true

# ── Backend (only when NEXT_PUBLIC_DEMO_MODE is not true) ─────────────────
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_RULES_API_URL=

# ── PeerJS signaling (WebRTC pairing) ─────────────────────────────────────
# Defaults point at the free PeerJS cloud broker. Override to self-host.
NEXT_PUBLIC_PEER_HOST=0.peerjs.com
NEXT_PUBLIC_PEER_PORT=443
NEXT_PUBLIC_PEER_SECURE=true

# ── LLM rule builder (optional) ───────────────────────────────────────────
OPENROUTER_API_KEY=
