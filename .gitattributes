# Enforce LF line endings for files that run inside Linux containers.
# Without this, Windows clones (with autocrlf=true) break shell scripts:
# /usr/bin/env: 'bash\r': No such file or directory

* text=auto eol=lf

*.sh           text eol=lf
*.bash         text eol=lf
Dockerfile     text eol=lf
*.Dockerfile   text eol=lf
entrypoint.sh  text eol=lf
*.yaml         text eol=lf
*.yml          text eol=lf
*.py           text eol=lf
*.toml         text eol=lf
*.ini          text eol=lf

# Binary files — never modify line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.onnx binary
*.pt   binary
*.pth  binary
