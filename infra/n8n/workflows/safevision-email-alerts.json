{
  "name": "SafeVision — Email Alerts",
  "nodes": [
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "safevision-email",
      "parameters": {
        "httpMethod": "POST",
        "path": "safevision-email",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000002",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [460, 180],
      "parameters": {
        "respondWith": "text",
        "responseBody": "accepted",
        "options": {
          "responseCode": 202
        }
      }
    },
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000003",
      "name": "Severity Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [460, 420],
      "parameters": {
        "mode": "expression",
        "output": "single",
        "value": "={{ $json.body.severity }}",
        "rules": {
          "rules": [
            {
              "conditions": {
                "conditions": [
                  {
                    "id": "sev-001",
                    "leftValue": "={{ $json.body.severity }}",
                    "rightValue": "critical",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "critical"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "id": "sev-002",
                    "leftValue": "={{ $json.body.severity }}",
                    "rightValue": "high",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "high"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "id": "sev-003",
                    "leftValue": "={{ $json.body.severity }}",
                    "rightValue": "medium",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "medium"
            }
          ]
        },
        "fallbackOutput": "extra"
      }
    },
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000004",
      "name": "Format Email",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [700, 420],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "fields": {
          "values": [
            {
              "name": "to",
              "type": "stringValue",
              "value": "={{ $vars.ALERT_EMAIL_RECIPIENT }}"
            },
            {
              "name": "subject",
              "type": "stringValue",
              "value": "=[SafeVision] {{ $json.body.severity.toUpperCase() }} Alert — {{ $json.body.rule_name.replace(/_/g, ' ') }}"
            },
            {
              "name": "html",
              "type": "stringValue",
              "value": "=<html><body style=\"font-family:sans-serif;max-width:600px;margin:auto\">\n<div style=\"background:#dc2626;color:white;padding:16px 24px;border-radius:8px 8px 0 0\">\n  <h2 style=\"margin:0\">🚨 SafeVision Safety Alert</h2>\n  <p style=\"margin:4px 0 0\">Severity: <strong>{{ $json.body.severity.toUpperCase() }}</strong></p>\n</div>\n<div style=\"background:#f9fafb;padding:24px;border:1px solid #e5e7eb;border-top:none;border-radius:0 0 8px 8px\">\n  <table style=\"width:100%;border-collapse:collapse\">\n    <tr><td style=\"padding:8px 0;color:#6b7280;width:120px\">Rule</td><td style=\"padding:8px 0;font-weight:600\">{{ $json.body.rule_name.replace(/_/g, ' ') }}</td></tr>\n    <tr><td style=\"padding:8px 0;color:#6b7280\">Zone</td><td style=\"padding:8px 0\">{{ $json.body.zone_id.replace(/_/g, ' ') }}</td></tr>\n    <tr><td style=\"padding:8px 0;color:#6b7280\">Camera</td><td style=\"padding:8px 0\">{{ $json.body.camera_id }}</td></tr>\n    <tr><td style=\"padding:8px 0;color:#6b7280\">Detected at</td><td style=\"padding:8px 0\">{{ new Date($json.body.detected_at).toUTCString() }}</td></tr>\n    <tr><td style=\"padding:8px 0;color:#6b7280\">Event ID</td><td style=\"padding:8px 0;font-family:monospace;font-size:12px\">{{ $json.body.event_id }}</td></tr>\n  </table>\n  <hr style=\"border:none;border-top:1px solid #e5e7eb;margin:16px 0\">\n  <p style=\"color:#6b7280;font-size:12px;margin:0\">Acknowledge this incident in the <a href=\"http://{{ $vars.SAFEVISION_HOST }}\">SafeVision dashboard</a>.</p>\n</div>\n</body></html>"
            },
            {
              "name": "text",
              "type": "stringValue",
              "value": "=SafeVision Safety Alert\nSeverity: {{ $json.body.severity.toUpperCase() }}\nRule: {{ $json.body.rule_name.replace(/_/g, ' ') }}\nZone: {{ $json.body.zone_id.replace(/_/g, ' ') }}\nCamera: {{ $json.body.camera_id }}\nDetected: {{ $json.body.detected_at }}\nEvent ID: {{ $json.body.event_id }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000005",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [940, 420],
      "parameters": {
        "fromEmail": "={{ $vars.ALERT_EMAIL_FROM }}",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "html",
        "html": "={{ $json.html }}",
        "text": "={{ $json.text }}",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "smtp-credentials",
          "name": "SMTP"
        }
      }
    },
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000006",
      "name": "Log Success",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1160, 420],
      "parameters": {}
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
