# SafeVision Infrastructure — Environment Variables
# Copy to .env and fill in real values before running docker compose.
# NEVER commit .env to git.

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=safevision
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=safevision

# ─── Redis ────────────────────────────────────────────────────────────────────
# Used internally; override only if you expose Redis on a non-standard port.
REDIS_URL=redis://redis:6379/0

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio

# ─── Grafana ──────────────────────────────────────────────────────────────────
GF_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme_grafana

# ─── Application Services ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://safevision:changeme_postgres@postgres:5432/safevision
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_minio
MINIO_BUCKET_INCIDENTS=incidents

# ─── Camera / Ingestion ──────────────────────────────────────────────────────
# RTSP URL for camera 01; used by the ingestion service when running in compose.
CAM01_RTSP_URL=rtsp://mediamtx:8554/cam01

# Frames per second to sample from each camera stream (default 5).
FPS_TARGET=5.0

# How often (seconds) ingestion polls Redis for camera config changes (default 30).
CAMERA_POLL_INTERVAL_SECS=30

# CPU or cuda — set to cuda when NVIDIA GPU passthrough is enabled.
INFERENCE_DEVICE=cpu

# Optional: URL to download a production PPE-trained ONNX model on inference startup.
# Leave blank to auto-export the base YOLOv8n as a dev placeholder.
MODEL_URL=

# ─── Configuration UI ─────────────────────────────────────────────────────────
# OpenRouter API key for the chat-based rule builder (Llama 3.1 8B).
# Obtain from https://openrouter.ai — leave blank to disable AI rule generation.
OPENROUTER_API_KEY=

# Internal service URL used by Next.js server-side (docker-compose network).
NEXT_PUBLIC_RULES_API_URL=http://rule-engine:8003

# ─── Clip retention ───────────────────────────────────────────────────────────
# Evidence clips are automatically deleted from MinIO after this many days.
CLIP_RETENTION_DAYS=90

# ─── Authentication ───────────────────────────────────────────────────────────
# Long random string — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-long-random-string

# JWT lifetime (hours). Default: 24.
JWT_EXPIRE_HOURS=24

# Comma-separated list of "username:password:role" entries.
# Roles: operator | supervisor | admin
# Change all passwords before deploying!
AUTH_USERS=admin:changeme_admin:admin,operator1:changeme_op:operator

# ─── OpenTelemetry (optional) ─────────────────────────────────────────────────
# Set to your OTLP gRPC collector endpoint to enable distributed tracing.
# Example: OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Leave blank to disable tracing (default).
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── Miscellaneous ────────────────────────────────────────────────────────────
TIMEZONE=UTC
LOG_LEVEL=INFO
